{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:visual-asset-pipeline:manifest:1.0.0",
  "title": "Visual Asset Pipeline plan and delivery manifest",
  "type": "object",
  "required": [
    "schema_version",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "project": {
      "type": "object"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "alpha_required",
          "brief",
          "outputs",
          "consumers"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "status": {
            "enum": [
              "planned",
              "generated",
              "prepared",
              "installed",
              "integrated",
              "verified",
              "blocked"
            ]
          },
          "alpha_required": {
            "type": "boolean"
          },
          "source_method": {
            "enum": [
              "reuse",
              "extract",
              "restore",
              "edit",
              "generate",
              "deterministic"
            ]
          },
          "brief": {
            "type": "object",
            "required": [
              "purpose"
            ],
            "properties": {
              "purpose": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256",
                "width",
                "height",
                "bytes",
                "format"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "public_url": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "width": {
                  "type": "integer",
                  "minimum": 1
                },
                "height": {
                  "type": "integer",
                  "minimum": 1
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "format": {
                  "enum": [
                    "PNG",
                    "JPEG",
                    "WEBP",
                    "AVIF"
                  ]
                },
                "variant": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "consumers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "file",
                "route",
                "selector",
                "kind"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "route": {
                  "type": "string"
                },
                "selector": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "image",
                    "background",
                    "mask"
                  ]
                },
                "pseudo": {
                  "enum": [
                    "::before",
                    "::after"
                  ]
                },
                "viewport_widths": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 240,
                    "maximum": 3840
                  }
                }
              },
              "additionalProperties": true
            }
          },
          "qa": {
            "type": "object"
          },
          "provenance": {
            "type": "object"
          },
          "blocked_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
